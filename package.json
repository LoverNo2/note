{
  "name": "notebook",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "一个冷调极简风格的 Vue3 笔记本：本地存储、自动保存、JSON 导入导出。",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "yarn test:html && yarn test:engine",
    "test:html": "esbuild src/editor/html.ts --bundle --format=cjs --platform=node --outfile=node_modules/.cache/html-test.cjs --log-level=error && node tests/html.smoke.cjs",
    "test:engine": "esbuild src/editor/blocks.ts --bundle --format=cjs --platform=node --outfile=node_modules/.cache/blocks-test.cjs --log-level=error && node tests/engine.smoke.cjs"
  },
  "dependencies": {
    "vue": "^3.4.38"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^5.1.4",
    "jsdom": "24.1.3",
    "typescript": "~5.6.2",
    "vite": "^5.4.8",
    "vue-tsc": "^2.1.6"
  }
}
